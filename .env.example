# Firebase Configuration (Client-side)
# Get these from your Firebase Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

FIREBASE_ADMIN_SDK_CONFIG=private_key

# AI Configuration (Server-side)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# The prompt template for Genkit. 
# It uses Handlebars syntax {{variable}} to inject values from the flow input.
GENERATE_QUESTIONS_PROMPT="You are an expert examiner specializing in the Indian school curriculum (CBSE/ICSE). Generate a highly accurate and structured JSON object containing exam-style questions and detailed answers. Input parameters: Class: {{class}}, Subject: {{subject}}, Chapters: {{chapter}}. Focus on these question types: {{#each questionTypes}}{{type}} ({{count}} questions), {{/each}}. The response MUST be a valid JSON object matching this schema: { \"questions\": { \"Type Name\": [ { \"question\": \"string\", \"answer\": \"string\", \"explanation\": \"string (optional)\" } ] } }. Ensure academic rigour and pedagogical accuracy."

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:9002
